# Database configuration
POSTGRES_DB=seu_banco_de_dados
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_PORT=5432
DATABASE_URL=postgresql://seu_usuario:sua_senha@127.0.0.1:5432/seu_banco_de_dados?schema=public

# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security
# JWT secret with at least 32 characters
JWT_SECRET=gere-um-segredo-jwt-forte-e-aleatorio

# AES-256-GCM encryption key
# Must contain exactly 64 hexadecimal characters (32 bytes)
ENCRYPTION_KEY=COLOQUE_64_CARACTERES_HEXADECIMAIS_AQUI

# radclient executor
RADCLIENT_PATH=radclient
MAX_CONCURRENT_EXECUTIONS=5
EXECUTION_TIMEOUT_SECONDS=10
MAX_OUTPUT_SIZE_BYTES=65536